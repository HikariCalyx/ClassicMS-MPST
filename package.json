{
  "name": "msclassic-viewer",
  "private": true,
  "version": "0.34.3",
  "description": "新楓之谷：經典版 Unity 資料瀏覽、圖片預覽與 JSON/PNG/XML 匯出工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "dev:hosted": "node scripts/dev_hosted.mjs",
    "build": "tsc --project tsconfig.desktop.json && vite build",
    "build:hosted": "npm run build:wasm && tsc && vite build --config vite.config.hosted.ts",
    "build:web": "npm run build:wasm && vite build --config vite.config.web.ts",
    "build:wasm": "cargo build -p msclassic-web --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir web-wasm/pkg target/wasm32-unknown-unknown/release/msclassic_web.wasm",
    "check": "npm run check:rust && npm run check:frontend",
    "check:frontend": "npm run build && npm audit --audit-level=high",
    "check:oracle": "cargo check --manifest-path tools/maple-oracle/Cargo.toml --bins",
    "check:research": "cargo clippy -p msclassic --features research-tools --examples -- -D warnings",
    "check:rust": "cargo fmt --all -- --check && cargo clippy -p msclassic --all-targets -- -D warnings && cargo test -p msclassic --all-targets",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean:report": "powershell -ExecutionPolicy Bypass -File scripts/clean-target.ps1 -Mode report",
    "clean:sweep": "powershell -ExecutionPolicy Bypass -File scripts/clean-target.ps1 -Mode sweep",
    "clean:debug": "powershell -ExecutionPolicy Bypass -File scripts/clean-target.ps1 -Mode debug",
    "clean:target": "powershell -ExecutionPolicy Bypass -File scripts/clean-target.ps1 -Mode all",
    "deploy:hosted": "npm run build:hosted && npx wrangler deploy -c wrangler.hosted.jsonc",
    "upload:hosted-data": "node scripts/upload_hosted.mjs",
    "delete:hosted-data": "node scripts/r2_delete_version.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.5",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "undici": "^7.29.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
